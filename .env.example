# 复制为 .env 后按需修改；docker compose 会自动读取

# 宿主机映射端口
APP_PORT=3000

# 对外访问地址（生成免登录门店链接/二维码时使用，需带 http(s)://，不带结尾斜杠）
# 留空则按请求的 Host 头推导，反向代理场景建议显式设置
PUBLIC_BASE_URL=

# 业务时区相对 UTC 的小时偏移（默认东八区）
APP_TZ_OFFSET=8

# 登录会话有效天数
SESSION_DAYS=14

# HTTPS 部署时设为 1，使会话 Cookie 带 Secure 标记
COOKIE_SECURE=0

# 首次启动时创建的总部管理员（密码留空则随机生成，见 data/initial-admin-password.txt）
# 配置了 INIT_ADMIN_PASSWORD 时密码以环境变量为唯一来源：每次启动校验并同步，系统内不可修改
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=

# 宿主机数据目录（SQLite、上传图片、IP 库）
DATA_DIR=./data
