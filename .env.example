# 复制为 .env 后按需修改；docker compose 会自动读取

# 宿主机映射端口
APP_PORT=3000

# 对外访问地址（生成免登录门店链接/二维码时使用，需带 http(s)://，不带结尾斜杠）
# 留空则按请求的 Host 头推导，反向代理场景建议显式设置
PUBLIC_BASE_URL=

# 业务时区相对 UTC 的小时偏移（默认东八区）
APP_TZ_OFFSET=8

# 登录会话有效天数
SESSION_DAYS=14

# HTTPS 部署时设为 1，使会话 Cookie 带 Secure 标记
COOKIE_SECURE=0

# 首次启动时创建的总部管理员（密码留空则随机生成，见 data/initial-admin-password.txt）
# 配置了 INIT_ADMIN_PASSWORD 时密码以环境变量为唯一来源：每次启动校验并同步，系统内不可修改
# 弱口令（如 admin123、纯数字、常见词、连续/重复字符）会在启动日志里报警告，请用 12 位以上随机密码
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=

# 宿主机数据目录（SQLite、上传图片、IP 库）
DATA_DIR=./data

# 备份策略（compose 的 environment 是白名单，改这里即生效）
# 定时自动备份间隔（小时），0 关闭；启动时若最新一份已超过该间隔会立即补一份
AUTO_BACKUP_HOURS=24
# 各类备份保留份数，超出按时间从旧到新清理；手动备份永不自动删除
AUTO_BACKUP_KEEP=14
PRE_RESTORE_KEEP=5
PRE_UPGRADE_KEEP=3

# 镜像名与标签（仅 compose 使用）。升级时用日期标签，旧镜像留在本地便于回滚：
#   IMAGE_TAG=$(date +%F) docker compose up -d --build
#   IMAGE_TAG=2026-11-01 docker compose up -d      # 回滚，不要带 --build
IMAGE_NAME=store-sales-daybook
IMAGE_TAG=latest

# IP 库下载源与超时（留空即用内置默认值）
# 完全离线 / 内网部署时指向自建镜像，会排在其他下载源之前
IPDB_MIRROR_URL=
# 单次下载总超时（毫秒，默认 240000）；慢速链路可调大
IPDB_DOWNLOAD_TIMEOUT_MS=
# 连接后多久收不到新数据就放弃（毫秒，默认 45000）
IPDB_DOWNLOAD_IDLE_MS=
# 一轮「更新 IP 库」的总时间预算（毫秒，默认 300000）
IPDB_DOWNLOAD_BUDGET_MS=
